# ==============================================================================
# RESTAURANT QR FEEDBACK SYSTEM - BACKEND ENVIRONMENT CONFIGURATION
# Copy to .env and configure for each independent restaurant deployment.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="Restaurant QR Feedback & Review Assistance System"
API_V1_PREFIX=/api/v1

# Security & Secrets (Must be changed in production - minimum 32 random characters)
SECRET_KEY=replace-with-a-secure-random-32-char-secret-key-for-this-restaurant
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Database Configuration (Separate database for every restaurant)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=restaurant_paradise_db
MONGODB_CONNECT_TIMEOUT_MS=5000

# Initial Admin Credentials (Seeded on first startup)
INITIAL_ADMIN_EMAIL=admin@paradise.restaurant
INITIAL_ADMIN_PASSWORD=ParadiseAdmin@2026!

# Restaurant Branding & Specific Configuration
RESTAURANT_NAME="Paradise Restaurant"
RESTAURANT_SLUG="paradise-restaurant"
RESTAURANT_DESCRIPTION="Authentic Culinary Experience & Fine Dining"
RESTAURANT_LOGO_URL=""
RESTAURANT_PRIMARY_COLOR="#16a34a"
RESTAURANT_SECONDARY_COLOR="#15803d"
RESTAURANT_GOOGLE_REVIEW_URL="https://g.page/r/your-google-review-link"
RESTAURANT_QR_BASE_URL="http://localhost:3000/r"
RESTAURANT_CONTACT_PHONE="+1 (555) 234-5678"
RESTAURANT_CONTACT_EMAIL="contact@paradise.restaurant"
RESTAURANT_ADDRESS="123 Gourmet Blvd, Suite 100, Food City, FC 90210"

# Rate Limiting & Protection
MAX_REQUEST_BODY_SIZE=1048576
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_SCAN_PER_MINUTE=60
RATE_LIMIT_PAYMENT_PER_MINUTE=15
RATE_LIMIT_WEBHOOK_PER_MINUTE=60

# Commercial Subscription & Billing Configuration
SUBSCRIPTION_REQUIRED=True
SUBSCRIPTION_STATUS_DEFAULT=inactive
ALLOW_COMPLIMENTARY_TRIAL=False
SUBSCRIPTION_PLAN_NAME="Standard Monthly"
SUBSCRIPTION_PLAN_ID="plan_standard_monthly"
SUBSCRIPTION_AMOUNT_PAISE=24900
SUBSCRIPTION_BILLING_INTERVAL=monthly
PAYMENT_CURRENCY=INR
SUBSCRIPTION_GRACE_DAYS=0

# Razorpay Payment Gateway Configuration
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

